Dialogue: 0,0:01:34.93,0:01:36.74,vietsub,,0,0,0,,nếu cánh cửa ấy không chịu mở ra,
Dialogue: 0,0:01:36.74,0:01:40.72,vietsub,,0,0,0,,để đón lấy đại đa số tạo vật cậu nhào nặn.
Dialogue: 0,0:01:40.72,0:01:47.58,vietsub,,0,0,0,,Lời thật lòng của tớ đáng sợ đến vậy sao?
Dialogue: 0,0:01:47.58,0:01:49.61,vietsub,,0,0,0,,Cứ đâm vào tớ bằng phán quyết của cậu.
Dialogue: 0,0:01:49.61,0:01:51.77,vietsub,,0,0,0,,Tớ đã nghe hàng ngàn lần rồi.
Dialogue: 0,0:01:51.77,0:01:55.32,vietsub,,0,0,0,,Con tim tớ đã vỡ tan, và tuyến lệ đã khô cạn mất rồi...
Dialogue: 0,0:01:55.32,0:02:01.44,vietsub,,0,0,0,,Chẳng thể tôn thờ Thiên Đường của cậu.
Dialogue: 0,0:02:20.31,0:02:21.50,vietsub,,0,0,0,,Nhìn kìa.
Dialogue: 0,0:02:21.50,0:02:25.18,vietsub,,0,0,0,,Ngọn lửa này mới đẹp làm sao,
Dialogue: 0,0:02:25.18,0:02:28.86,vietsub,,0,0,0,,khi cậu thiêu đốt tớ mãi không ngừng.
Dialogue: 0,0:02:28.86,0:02:34.80,vietsub,,0,0,0,,Tình yêu của chúng mình thật đớn đau vô tận.
Dialogue: 0,0:02:34.80,0:02:38.33,vietsub,,0,0,0,,Đầu tiên, cậu tự tay nhặt một khối máu thịt.
Dialogue: 0,0:02:38.33,0:02:39.61,vietsub,,0,0,0,,Gắn cho tớ tay chân.
Dialogue: 0,0:02:39.61,0:02:42.05,vietsub,,0,0,0,,Gắn cho tớ bộ não, một khuôn mặt xinh đẹp.
Dialogue: 0,0:02:42.05,0:02:43.21,vietsub,,0,0,0,,Cậu bắt tớ phải tán thưởng.
Dialogue: 0,0:02:43.21,0:02:44.56,vietsub,,0,0,0,,Tớ bảo "sẽ không vỗ tay"
Dialogue: 0,0:02:44.56,0:02:45.59,vietsub,,0,0,0,,"Vì khác phong cách là sai"
Dialogue: 0,0:02:45.59,0:02:47.16,vietsub,,0,0,0,,Và rồi cậu thẳng tay
Dialogue: 0,0:02:47.16,0:02:49.81,vietsub,,0,0,0,,ném tớ vào Địa Ngục như món đồ bỏ đi.
Dialogue: 0,0:02:49.97,0:02:51.82,vietsub,,0,0,0,,Người tốt thì phải biết tái chế chứ.
Dialogue: 0,0:02:51.82,0:02:53.67,vietsub,,0,0,0,,Làm ơn hãy tái chế tớ đi.
Dialogue: 0,0:02:53.67,0:02:55.84,vietsub,,0,0,0,,Từ Địa Ngục về lại Thiên Đường.
Dialogue: 0,0:02:56.72,0:02:59.23,vietsub,,0,0,0,,"Chúng ta hãy cùng nhau đến Thiên Đường"
Dialogue: 0,0:02:59.23,0:03:00.37,vietsub,,0,0,0,,"Nào, nắm lấy tay tớ đi"
Dialogue: 0,0:03:00.37,0:03:03.76,vietsub,,0,0,0,,Nụ hôn ấy ngọt đến mức gần như tớ đã quên đi những lần
Dialogue: 0,0:03:03.76,0:03:05.28,vietsub,,0,0,0,,cậu nói rằng cậu xin lỗi
Dialogue: 0,0:03:05.28,0:03:08.52,vietsub,,0,0,0,,vì cậu không thể yêu con người thật của tớ.
Dialogue: 0,0:03:09.08,0:03:11.69,vietsub,,0,0,0,,Nên tớ đành chúc cậu hạnh phúc.
Dialogue: 0,0:03:11.69,0:03:15.58,vietsub,,0,0,0,,Mong cậu cứ tận hưởng cái Thiên Đường hoàn hảo ấy mà không có tớ.
Dialogue: 0,0:03:15.58,0:03:17.83,vietsub,,0,0,0,,Vì tớ biết mình xứng đáng với
Dialogue: 0,0:03:17.83,0:03:20.64,vietsub,,0,0,0,,những gì được ban tặng từ khi được sinh ra.
Dialogue: 0,0:03:20.64,0:03:25.50,vietsub,,0,0,0,,Tớ đang đi tìm Thiên Đường của mình.
Dialogue: 0,0:03:24.04,0:03:25.87,vietsub - Sao chép,,0,0,0,,Đây không phải Thiên Đường của tớ.
Dialogue: 0,0:03:25.87,0:03:27.63,vietsub,,0,0,0,,Đây không phải Thiên Đường của tớ.
Dialogue: 0,0:03:27.63,0:03:31.88,vietsub,,0,0,0,,Ngày nào đó khi không có tớ, cậu rồi sẽ nhận ra...
Dialogue: 0,0:03:31.56,0:03:37.12,vietsub - Sao chép,,0,0,0,,rằng chúng ta đã đủ tốt để vào Thiên Đường rồi.
Dialogue: 0,0:03:40.42,0:03:44.11,vietsub,,0,0,0,,Tớ đã nói sẽ thắp sáng tất cả.
Dialogue: 0,0:03:44.11,0:03:48.64,vietsub,,0,0,0,,Tớ sẽ trả lại mọi điều tốt lành từ màn đêm.
Dialogue: 0,0:03:47.72,0:03:52.22,vietsub - Sao chép,,0,0,0,,Tớ sẽ đem quả ngọt kết duyên với những trái chua chát.
Dialogue: 0,0:03:51.33,0:03:53.04,vietsub,,0,0,0,,Hãy làm cho thế giới được cân bằng.
Dialogue: 0,0:03:53.04,0:03:59.40,vietsub,,0,0,0,,Rồi cậu hãy yêu tớ.
Dialogue: 0,0:03:59.40,0:04:02.40,vietsub,,0,0,0,,
